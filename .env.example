# =============================================================================
# PetVacay — variables de entorno para PRODUCCIÓN
# =============================================================================
#
# Copia este fichero como `.env` en la raíz del proyecto y rellena los valores.
# `docker compose` lo lee automáticamente:
#
#   cp .env.example .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# El compose de producción usa la sintaxis `${VAR:?mensaje}` en las variables
# críticas, así que **fallará al arrancar** si falta alguna. Es deliberado:
# preferible no arrancar que arrancar con la contraseña de ejemplo.
#
# NUNCA subas el `.env` real al repositorio (ya está en .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# BASES DE DATOS
# -----------------------------------------------------------------------------

# PostgreSQL — contenedor `postgres-db`.
# Lo consumen: identity-service, booking-service y payment-service, cada uno
# contra su propia base de datos lógica (identity / booking / payment).
POSTGRES_PASSWORD=cambia-esta-contrasena

# MongoDB — contenedor `mongodb`.
# Lo consume: search-service (es su único almacén; no tiene base relacional).
MONGO_PASSWORD=cambia-esta-contrasena


# -----------------------------------------------------------------------------
# FIRMA DE TOKENS JWT  →  identity-service
# -----------------------------------------------------------------------------

# Ruta a la clave PRIVADA RSA dentro del contenedor. Es el secreto más sensible
# del sistema: quien la tenga puede emitir tokens válidos para cualquier usuario.
# No debe viajar dentro de la imagen; se monta como volumen (ver JWT_KEYS_DIR).
#
# Generar un par nuevo para producción (el del repositorio es SOLO desarrollo):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
PETVACAY_JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/keys/jwt-private.pem

# Directorio del host que se monta en /run/secrets/keys (solo lectura).
JWT_KEYS_DIR=./infra/keys

# Clave PÚBLICA de verificación. La necesitan los CUATRO servicios y el Gateway.
# No es un secreto (está pensada para ser conocida), pero sí debe coincidir con
# la privada de arriba o ningún token se validará.
#
# OJO: hoy la clave pública va empaquetada en `common` y en `gateway-service`.
# Al rotar las claves hay que definir esta variable en AMBOS sitios, porque son
# dos copias distintas del mismo fichero (ver gateway-service/.../keys/README.md).
PETVACAY_JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/keys/jwt-public.pem

# Duracion de los tokens. Opcionales: si no se definen, identity-service usa
# 8 horas para el access token y 30 dias para el refresh token. Formato
# ISO-8601 de duracion (PnDTnHnMnS).
PETVACAY_JWT_TOKEN_LIFETIME=PT8H
PETVACAY_JWT_REFRESH_LIFETIME=P30D


# -----------------------------------------------------------------------------
# CUENTA DE ADMINISTRADOR INICIAL  →  identity-service
# -----------------------------------------------------------------------------

# Se crea al arrancar si no existe. Es la única forma de tener un ROLE_ADMIN:
# el endpoint público de registro nunca concede ese rol, a propósito.
# Si dejas la contraseña por defecto, el servicio lo avisa en cada arranque.
PETVACAY_ADMIN_EMAIL=admin@tu-dominio.com
PETVACAY_ADMIN_PASSWORD=cambia-esta-contrasena


# -----------------------------------------------------------------------------
# COOKIES DE SESIÓN  →  identity-service
# -----------------------------------------------------------------------------

# La cookie del token de refresco lleva `Secure`, así que solo viaja por HTTPS.
# Debe quedarse en `true` en producción; ponerlo a `false` expondría la sesión
# a cualquiera que pueda leer el tráfico.
PETVACAY_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# GEOCODIFICACIÓN (Nominatim/OpenStreetMap)  →  search-service
# -----------------------------------------------------------------------------

# Nominatim RECHAZA peticiones sin un User-Agent que identifique la app y un
# contacto real — es su política de uso, no un capricho. El valor de ejemplo
# solo vale para desarrollo.
PETVACAY_GEOCODING_USER_AGENT=PetVacay/1.0 (contacto@tu-dominio.com)


# -----------------------------------------------------------------------------
# CORS  →  gateway-service
# -----------------------------------------------------------------------------

# Dominios del frontend, separados por comas. El Gateway es el único origen que
# el navegador contacta, así que es el único sitio donde se declara CORS.
# No admite `*`: con credenciales, el navegador rechaza el comodín.
PETVACAY_CORS_ALLOWED_ORIGINS=https://petvacay.com,https://www.petvacay.com


# -----------------------------------------------------------------------------
# PASARELA DE PAGO (Stripe)  →  payment-service
# -----------------------------------------------------------------------------

# `stripe` activa la integración real; `simulated` usa el adaptador de
# desarrollo, que no cobra nada. En producción debe ser `stripe`.
PETVACAY_PAYMENTS_PROVIDER=stripe

# Clave SECRETA de Stripe (sk_live_... en producción, sk_test_... en pruebas).
# Solo la tiene payment-service; jamás debe llegar al navegador.
STRIPE_SECRET_KEY=sk_live_cambia-esto

# Secreto de firma del webhook (whsec_...). Lo da Stripe al registrar el
# endpoint. Sin él, payment-service responde 503 y DESCARTA los eventos: es
# preferible perder notificaciones a aceptar pagos que no puede verificar.
# Registrar el endpoint en Stripe como:
#   https://tu-dominio.com/api/v1/payments/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_cambia-esto


# -----------------------------------------------------------------------------
# FRONTEND (se compila DENTRO de la imagen, en tiempo de build)
# -----------------------------------------------------------------------------
#
# Vite incrusta estas variables en el bundle: son públicas por definición y
# cualquiera puede leerlas en el navegador. No pongas aquí ningún secreto.

# Clave PUBLICABLE de Stripe (pk_live_...). Identifica la cuenta; no autoriza
# cobros por sí sola. Si falta, el formulario de tarjeta se deshabilita con un
# aviso en lugar de fallar en silencio.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_cambia-esto


# =============================================================================
# NOTAS DE DESPLIEGUE
# =============================================================================
#
# 1. HTTPS es obligatorio. La cookie de refresco lleva `Secure` y el navegador
#    no la enviará por HTTP: sin TLS, nadie podrá mantener la sesión. El
#    certificado se termina en el proxy de entrada, delante del Gateway.
#
# 2. `X-Forwarded-For` la sobrescribe Nginx con `$remote_addr` (ver nginx.conf).
#    Es deliberado: `$proxy_add_x_forwarded_for` CONCATENA en vez de reemplazar,
#    y el Gateway lee el primer valor de la cabecera para el rate limiting — con
#    concatenar, un cliente podría anteponer una IP falsa y saltarse el límite.
#    Si en tu despliegue añades OTRO proxy delante de Nginx (un balanceador de
#    la nube, Cloudflare...), repite el mismo criterio ahí: sobrescribir, nunca
#    reenviar la cabecera del cliente tal cual.
#
# 3. En producción solo el Gateway (y el frontend) publican puerto. Postgres,
#    MongoDB, Kafka y Redis quedan accesibles únicamente dentro de la red de
#    Docker; `docker-compose.prod.yml` ya lo aplica.
#
# 4. Kafka arranca con `KAFKA_AUTO_CREATE_TOPICS_ENABLE=true`, cómodo en
#    desarrollo pero poco recomendable en producción: un typo en un nombre de
#    topic crea uno nuevo en silencio en lugar de fallar. Conviene crear los
#    topics explícitamente y desactivar esa opción.
#
# 5. El bootstrap del administrador solo actúa si la cuenta no existe. Cambiar
#    `PETVACAY_ADMIN_PASSWORD` después del primer arranque NO cambia la
#    contraseña ya guardada.
